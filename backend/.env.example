RESEND_API_KEY=
RESEND_FROM=SRJ Tech Website <onboarding@resend.dev>

# Gmail SMTP — works locally; use an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=srjtechsupport@gmail.com
SMTP_PASS=
MAIL_FROM="SRJ Tech Website <srjtechsupport@gmail.com>"
MAIL_TO=srjtechsupport@gmail.com
MAIL_AUTO_REPLY=true
